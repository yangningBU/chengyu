server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    index index.html;

    types {
        text/html html;
        text/css css;
        application/javascript js;
        text/csv csv;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Fingerprinted assets (name.<hash>.ext) never change, so cache forever.
    location ~* "\.[0-9a-f]{8}\.(css|js|csv)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
